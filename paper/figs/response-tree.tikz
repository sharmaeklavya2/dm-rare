\begin{tikzpicture}[x=1cm,y=1cm,font=\fontsize{9}{10.8}\selectfont,
  state/.style={draw=blue!55!black,fill=blue!5,rounded corners=2pt,text width=3.7cm,minimum height=1.52cm,align=center},
  link/.style={-{Stealth[length=2mm]},line width=.8pt,draw=black!65}]
\path[use as bounding box] (-.2,-2.3) rectangle (15,3.1);
\node[state] (p) at (2.05,1.25) {\textbf{Current profile}\\$p$\\Revenue $R_i(p)$};
\node[state,draw=orange!70!black,fill=orange!7] (s) at (7.4,1.25) {\textbf{Seller $i$ deviates}\\$(s,p_{-i})$\\Rival baseline $R_j(s,p_{-i})$};
\node[state,draw=teal!65!black,fill=teal!5] (q) at (12.75,1.25)
    {\textbf{Competitors respond}\\$(s,q_{-i})$\\$q_{-i}\in\IR_i(s,p_{-i})$};
\draw[link] (p.east)--(s.west);
\draw[link] (s.east)--(q.west);
\node at (4.72,2.34) {Deviation};
\node at (10.07,2.34) {Joint response};
\node[draw=black!30,rounded corners=2pt,fill=white,text width=6.6cm,align=center,minimum height=1.03cm] (ir) at (11.4,-.93)
 {\textbf{Each competitor accepts}\\$R_j(s,q_{-i})\ge R_j(s,p_{-i})\quad(j\ne i)$};
\node[draw=black!30,rounded corners=2pt,fill=white,text width=6.6cm,align=center,minimum height=1.03cm] (det) at (3.45,-.93)
 {\textbf{Initial deviation is deterred}\\$R_i(s,q_{-i})\le R_i(p)$};
\draw[draw=black!45,line width=.8pt] (q.south)--(12.75,.03);
\draw[link,draw=teal!65!black] (12.75,.03)--(ir.north);
\draw[link,draw=black!45] (12.75,.03)--(3.45,.03)--(det.north);
\node at (7.4,-2.06) {RARE requires an admissible deterring response for every seller and every deviation.};
\end{tikzpicture}
